{
    // STM32Cube for VS Code（stm32-vscode-extension 3.x）のデバッグ構成。
    // ST-Link GDB Server・GDB・SVD は拡張のバンドル（%LOCALAPPDATA%/stm32cube/bundles）
    // から自動解決されるため、CubeCLT のパス設定（旧 STM32VSCodeExtension.cubeCLT.path）は不要。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32Cube: Build & Debug (ST-Link)",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "deviceName": "STM32H533RETx",
            "serverInterface": "SWD",
            // CMake Tools のビルド（選択中のプリセット）を実行してから起動
            "preBuild": "${command:cmake.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:cmake.launchTargetPath}"
                }
            ]
        }
    ]
}
